{
  "name": "wugesture-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.checkjs.json --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,scss}\" \"*.{js,ts,json}\""
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "vue": "^3.5.46",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.5.1",
    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "~7.0.2",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
