    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,scss}\" \"*.{js,ts,json}\""
