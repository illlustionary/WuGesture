    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "typescript": "~5.9.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
