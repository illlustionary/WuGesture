<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <AssemblyName>WuGesture</AssemblyName>
    <Version>1.1.11</Version>
    <Title>WuGesture</Title>
    <Product>WuGesture</Product>
    <ApplicationIcon>Resources\wu.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\..\artifacts\debug\WuGesture\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\..\artifacts\release\WuGesture\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WuGesture.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="Web\package.json" />
    <None Include="Web\vite.config.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Any file in the Vite project counts as an input for the incremental frontend build. -->
    <WebFrontendSource Include="Web\**\*" Exclude="Web\node_modules\**\*;Web\*.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\sun.png" />
    <EmbeddedResource Include="Resources\volume.png" />
  </ItemGroup>

  <!-- Resolve the Vite output directory first: it differs between a normal build and a publish run. -->
  <Target Name="ResolveWebFrontendOutput">
    <PropertyGroup>
      <WebFrontendOutputPath Condition="'$(_IsPublishing)' == 'true'">$(PublishDir)\Web</WebFrontendOutputPath>
      <WebFrontendOutputPath Condition="'$(_IsPublishing)' != 'true'">$(OutputPath)\Web</WebFrontendOutputPath>
    </PropertyGroup>

    <ConvertToAbsolutePath Paths="$(WebFrontendOutputPath)">
      <Output TaskParameter="AbsolutePaths" PropertyName="WebFrontendOutputPath" />
    </ConvertToAbsolutePath>
  </Target>

  <!-- MSBuild skips the whole target when every source is older than the emitted index.html. Vite hashes
       asset names, so index.html is rewritten on every real frontend change. -->
  <Target Name="BuildWebFrontend"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ResolveWebFrontendOutput"
          Inputs="@(WebFrontendSource)"
          Outputs="$(WebFrontendOutputPath)\index.html">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\Web"
      Command="pnpm exec vite build --outDir &quot;$(WebFrontendOutputPath)&quot;" />
  </Target>

</Project>
